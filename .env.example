# Default local mode: no provider calls. Only the bundled synthetic demo is reviewed.
REVIEW_MODE=demo
OPENAI_API_KEY=
# Original template default. The owner selected gpt-6.1-sol for the Render pilot
# on 12 October 2026; explicitly override REVIEW_MODEL in Render.
REVIEW_MODEL=gpt-6-astra
REVIEW_REASONING_EFFORT=medium
# Source default is 30; the suggested initial Render pilot allowance is 10.
REVIEW_DAILY_CALL_LIMIT=30
REVIEW_NETWORK_HOURLY_CALL_LIMIT=12
REVIEW_CONCURRENCY=3
# One overall deadline, including a correction; maximum 15 minutes.
REVIEW_TIMEOUT_MS=900000
# Numerical request/score records only. Kept until the operator deletes them.
# Requires the existing Redis credentials; demo requests are never recorded.
ANALYTICS_ENABLED=true
# Required for live production. APP_ORIGIN is an exact HTTPS origin, no path.
APP_ORIGIN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LIMIT_KEY_SECRET=
# Original Vercel template value. Render's documented candidate is x-forwarded-for;
# use that Render-specific override and verify spoof handling on the hosted service.
TRUSTED_IP_HEADER=x-vercel-forwarded-for
