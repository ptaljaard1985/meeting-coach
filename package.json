{
  "name": "meeting-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib tests scripts proxy.ts next.config.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify:pdf": "node --import tsx scripts/verify-pdf.tsx",
    "calibrate": "node --import tsx scripts/calibrate.ts",
    "analytics:export": "node --import tsx scripts/analytics.ts export",
    "analytics:delete": "node --import tsx scripts/analytics.ts delete"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@react-pdf/renderer": "4.9.0",
    "next": "16.3.8",
    "openai": "7.27.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "undici": "7.28.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "happy-dom": "20.14.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "type": "module"
}
